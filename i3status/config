general {
  output_format = "i3bar"
  colors = true
  color_good = "#FFFFFF"
  color_degraded = "#FFFF00"
  color_bad = "#FF0000"
  interval = 5
}

order += "ethernet _first_"
order += "memory"
order += "tztime local"

ethernet _first_ {
        format_up = "E: %ip"
        format_down = "E: down"
}

memory {
        format = "%used"
        threshold_degraded = "1G"
        format_degraded = "MEMORY < %available"
}

tztime local {
        format = "%H:%M:%S"
}
